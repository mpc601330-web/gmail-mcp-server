# Server
PORT=3000
SERVER_URL=https://your-app.railway.app

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encryption key for stored refresh tokens (use any random string, 32+ chars)
ENCRYPTION_KEY=generate-a-random-string-at-least-32-characters

# Password to access the /setup page
ADMIN_PASSWORD=pick-a-strong-password

# Data directory for token storage (default: ./data)
# DATA_DIR=./data

# Auren Mail (values below are examples only)
AUREN_DIGEST_RECIPIENT=central-inbox@example.com
AUREN_SENDER_ACCOUNT=collector@example.com
AUREN_STATE_DIR=./data/auren
AUREN_MAX_PART_BYTES=18000000
AUREN_INITIAL_LOOKBACK_DAYS=7
AUREN_THREAD_MAX_MESSAGES=20
AUREN_TIMEZONE=Europe/Madrid
